@{
    ViewData["Title"] = "Dashboard Analytique ";
 }

<!-- breadcrumbs -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb my-breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>

        <li class="breadcrumb-item active" aria-current="page">Projets</li>
    </ol>
</nav>
<!-- //breadcrumbs -->


<div class="card card_border p-lg-5 p-3 mb-4">
    <div class="cards__heading">
        <h3> @ViewData["Title"] <span></span></h3>
        
    </div>
    <div class="card-body py-3 p-0">

        <section id="report-container" class="embed-container col-lg"></section>
        <!-- Used to display report embed error messages -->
        <section class="error-container m-5"></section>

    </div>
</div>

@section Scripts {
    <script src="~/js/Pbi.js"></script>
    <script>$(document).ready(load(""));</script>
}

