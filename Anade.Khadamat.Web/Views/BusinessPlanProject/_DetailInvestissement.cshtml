@model IEnumerable<Anade.Khadamat.Domain.DetailInvestissement>
<partial name="_Message" />

<div class="modal-header">
    <h5 class="modal-title" id="modalLabel">Ajouter une Apréciation</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>

<div class="modal-body">
    <div id="modalMessages"></div>
    <div id="booking" class="section">
        <div class="section-center">
            <div class="container" style="max-height: auto">
                <div class="row">
                    <div class="col-md-12">
                        <div class="booking-form">
                            <form asp-action="DetailInvestissement" asp-controller="BusinessPlanProject"
                                  data-ajax="true"
                                  data-ajax-success="AddBusinessPlan">

                                <table class="table display compact">
                                    <thead>
                                        <tr>
                                            <th>
                                                @Html.DisplayNameFor(model => model.DesignationMateriel)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.DureeAmortissement)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.TypeMateriel.DesignationFr)
                                            </th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.DesignationMateriel)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.DureeAmortissement)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.TypeMateriel.DesignationFr)
                                                </td>
                                                <td>
                                                    <button data-bs-target="#modalBP" data-bs-toggle="modal" class="btn btn-secondary btn-sm"
                                                            data-url="@Url.Action("EditDetailInvestissement", "BusinessPlanProject", new { id = item.Id })">
                                                        Modifier
                                                    </button>
                                                </td>
                                            </tr>
                                        }

                                    </tbody>
                                </table>

                                <div class="form-group modal-footer">
                                    <input type="submit" class="btn btn-outline-primary" value="Soumettre" />
                                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    window.setTimeout(function () {
        $(".alert").fadeTo(500, 0).slideUp(500, function () {
            $(this).remove();
        });
    }, 2000);
</script>

