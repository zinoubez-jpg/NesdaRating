                                            </div>
                                        </div>

                                    </div>

                                    <br>

                                    <div class="card text-bg-primary mb-3">

                                        <div class="card-header">Calcule structure de financement</div>

                                        <div class="card-body">

                                            <div class="row">

                                                <div class="col-md-6">

                                                    <div class="row">

                                                        <div class="col-sm-8">
                                                            <div class="form-group">
                                                                <span class="form-label">Apport personnel</span>
                                                                <input id="ApportPersonnel" asp-for="StructureFinancement.ApportPersonnel" class="form-control" disabled>
                                                            </div>
                                                        </div>

                                                        <div class="col-sm-4">
                                                            <div class="form-group">
                                                                <span class="form-label">%</span>
                                                                <input id="TauxApportPersonnel" class="form-control" value="0" disabled>
                                                            </div>
                                                        </div>

                                                    </div>

                                                    <div class="row">

                                                        <div class="col-sm-8">
                                                            <div class="form-group">
                                                                <span class="form-label">CMT</span>
                                                                <input id="CMT" asp-for="StructureFinancement.CMT" class="form-control" disabled>
                                                            </div>
                                                        </div>

                                                        <div class="col-sm-4">
                                                            <div class="form-group">
                                                                <span class="form-label">%</span>
                                                                <input id="TauxCMT" class="form-control" value="0" disabled>
                                                            </div>
                                                        </div>

                                                    </div>

                                                    <div class="row">

                                                        <div class="col-sm-8">
                                                            <div class="form-group">
                                                                <span class="form-label">PNR classique</span>
                                                                <input id="PNRClassique" asp-for="StructureFinancement.PNRClassique" class="form-control" disabled>
                                                            </div>
                                                        </div>

                                                        <div class="col-sm-4">
                                                            <div class="form-group">
                                                                <span class="form-label">%</span>
                                                                <input id="TauxPNRClassique" class="form-control" value="0" disabled>
                                                            </div>
                                                        </div>

                                                    </div>

                                                </div>

                                                <div class="col-md-6">

                                                    <div class="row">

                                                        <div class="col">
                                                            <div class="form-group">
                                                                <span class="form-label">Différé emprunt</span>
                                                                <input id="DiffereEmprunt" class="form-control" disabled>
                                                            </div>
                                                        </div>

                                                    </div>

                                                    <div class="row">

                                                        <div class="col">
                                                            <div class="form-group">
                                                                <span class="form-label">Exonération fiscale</span>
                                                                <input id="ExonerationFiscale" class="form-control" disabled>
                                                            </div>
                                                        </div>

                                                    </div>

                                                    <div class="row">

                                                        <div class="col-sm-4">
                                                            <div class="form-group">
                                                                <span class="form-label">Taux IFU</span>
                                                                <input id="TauxIFU" class="form-control" value="0%" disabled>
                                                            </div>
                                                        </div>

                                                        <div class="col-sm-4">
                                                            <div class="form-group">
                                                                <span class="form-label">Taux IBS</span>
                                                                <input id="TauxIBS" class="form-control" value="0%" disabled>
                                                            </div>
                                                        </div>

                                                        <div class="col-sm-4">
                                                            <div class="form-group center">
                                                                <button type="button" class="btn btn-outline-success" onclick="SimulerStructure();">Simuler la structure</button>
                                                            </div>
                                                        </div>

                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                    <div class="form-group modal-footer">
                                        <input type="submit" class="btn btn-outline-primary" value="Add" />
                                        <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    </div>

                                </div>

                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    var acc = document.getElementsByClassName("accordionZn");
    var i;

    for (i = 0; i < acc.length; i++) {
        acc[i].addEventListener("click", function () {
            this.classList.toggle("active");
            var panel = this.nextElementSibling;
            if (panel.style.maxHeight) {
                panel.style.maxHeight = null;
            } else {
                panel.style.maxHeight = panel.scrollHeight + "px";
            }
        });
    }
</script>

<script>
    function setActive(buttonContainerId, inputId, value) {
        // Désactiver tous les boutons dans le conteneur spécifié
        var buttons = document.querySelectorAll('#' + buttonContainerId + ' .value-btn');
        buttons.forEach(function (button) {
            button.classList.remove('active');
        });

        // Activer le bouton cliqué
        buttons[value].classList.add('active');

        // Mettre la valeur dans l'input correspondant
        document.getElementById(inputId).value = value;
    }
</script>

<script>

    $(document).ready(function () {
        var i = 1;
        $("#add_row").click(function () {
            b = i - 1;
            $('#addr' + i).html($('#addr' + b).html()).find('td:first-child').html(i + 1);
            $('#tab_logic').append('<tr id="addr' + (i + 1) + '"></tr>');
            i++;
        });
        $("#delete_row").click(function () {
            if (i > 1) {
                $("#addr" + (i - 1)).html('');
                i--;
            }
        });

    });

</script>

<script>

    function SimulerStructure() {

        var e = document.getElementById("CategorieId");

        var CategorieValue = e.value;
        var CategorieText = e.options[e.selectedIndex].text;

        e = document.getElementById("TypeActiviteId");
        var TypeActiviteValue = e.value;
        var TypeActiviteText = e.options[e.selectedIndex].text;

        e = document.getElementById("FormeJuridiqueId");
        var FormeJuridiqueValue = e.value;
        var FormeJuridiqueText = e.options[e.selectedIndex].text;

        e = document.getElementById("TypeFinancementId");
        var TypeFinancementValue = e.value;
        var TypeFinancementText = e.options[e.selectedIndex].text;

        e = document.getElementById("RegimeImpositionId");
        var RegimeImpositionValue = e.value;
        var RegimeImpositionText = e.options[e.selectedIndex].text;

        e = document.getElementById("CommuneBPId");
        var CommuneBPValue = e.value;
        var CommuneBPText = e.options[e.selectedIndex].text;





        if (TypeFinancementValue == 1) {

            ApportPersonnel.value = CoutProjet.value;
            TauxApportPersonnel.value = 100;
            CMT.value = 0;
            TauxCMT.value = 0;
            PNRClassique.value = 0;
            TauxPNRClassique.value = 0;

        } else {
            if (TypeFinancementValue == 2) {

                DiffereEmprunt.value = "1 ans";

                ApportPersonnel.value = parseFloat(CoutProjet.value) * 50 / 100;
                TauxApportPersonnel.value = 50;
                CMT.value = 0;
                TauxCMT.value = 0;
                PNRClassique.value = parseFloat(CoutProjet.value) * 50 / 100;
                TauxPNRClassique.value = 50;

            } else {
                if (TypeFinancementValue == 3) {

                    if (CategorieValue == 1) {

                        ApportPersonnel.value = parseFloat(CoutProjet.value) * 5 / 100;
                        TauxApportPersonnel.value = 5;
                        CMT.value = parseFloat(CoutProjet.value) * 70 / 100;
                        TauxCMT.value = 70;
                        PNRClassique.value = parseFloat(CoutProjet.value) * 25 / 100;
                        TauxPNRClassique.value = 25;

                    } else {

                        ApportPersonnel.value = parseFloat(CoutProjet.value) * 50 / 100;
                        TauxApportPersonnel.value = 50;
                        CMT.value = 0;
                        TauxCMT.value = 0;
                        PNRClassique.value = parseFloat(CoutProjet.value) * 50 / 100;
                        TauxPNRClassique.value = 50;

                    }
                    DiffereEmprunt.value = "1 an et 6 mois";

                } else {  /*Cas d'erreur affichage 0 par tous*/

                    ApportPersonnel.value = 0;
                    TauxApportPersonnel.value = 0;
                    CMT.value = 0;
                    TauxCMT.value = 0;
                    PNRClassique.value = 0;
                    TauxPNRClassique.value = 0;
                }

            }

        }




















    }

