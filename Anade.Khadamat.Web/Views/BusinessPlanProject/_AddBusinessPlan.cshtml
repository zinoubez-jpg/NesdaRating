@model Anade.Khadamat.Domain.BusinessPlan



<head>
    <title>Ajouter Buisiness Plan</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <style>

        .accordionZn:hover {
            background-color: #06BBCC;
        }

        .accordionZn:after {
            content: '\002B';
            color: #777;
            font-weight: bold;
            float: right;
            margin-left: 5px;
        }

        .accordionZn {
            background-color: #F0FBFC;
            color: #444;
            cursor: pointer;
            padding: 18px;
            width: 100%;
            border: none;
            text-align: left;
            outline: none;
            font-size: 15px;
            transition: 0.4s;
        }

        .active:after {
            content: "\2212";
        }

        .panel {
            padding: 0 18px;
            background-color: white;
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.2s ease-out;
        }
    </style>

</head>


<div class="modal-header">
    <h5 class="modal-title" id="modalLabel">Ajouter Business Plan</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>

<div class="modal-body">
    <div id="modalMessages"></div>
    <div id="booking" class="section">
        <div class="section-center">
            <div class="container" style="max-height: 100%">
                <div class="row">
                    <div class="col-md-12">
                        <div class="booking-form">

                            <form asp-action="AddBusinessPlan" asp-controller="BusinessPlanProject"
                                  data-ajax="true"
                                  data-ajax-success="addBusinessPlan">
                                <div class="row">
                                    <input asp-for="NumeroSIEJE" value="@(ViewBag.NumeroSIEJE)" type="hidden" />
                                </div>


                                <div class="container mt-3">

                                    <h3>Informations de base</h3>
                                    <br>

                                    <div class="row">

                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <span class="form-label">Coût du projet</span>
                                                <input id="CoutProjet" asp-for="InformationBase.CoutProjet" type="number" min="0.00" max="10000000.00" step="0.01" class="form-control">
                                            </div>
                                        </div>

                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <span class="form-label">Délai client (J)</span>
                                                <input id="DelaiClient" asp-for="InformationBase.DelaiClient" class="form-control">
                                            </div>
                                        </div>

                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <span class="form-label">Délai fournisseur (J)</span>
                                                <input id="DelaiFournisseur" asp-for="InformationBase.DelaiFournisseur" class="form-control">
                                            </div>
                                        </div>

                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <span class="form-label">Délai prestataire (J)</span>
                                                <input id="DelaiPrestataire" asp-for="InformationBase.DelaiPrestataire" class="form-control">
                                            </div>
                                        </div>

                                    </div>

                                    <div class="row">

                                        <div class="col-sm-3 form-group">
                                            <span class="form-label">Catégorie.</span>
                                            <select id="CategorieId" asp-for="InformationBase.CategorieId" asp-items="@ViewBag.CategorieID as SelectList" class="form-control select2" required>
                                                <option value="">- - - - - -</option>
                                            </select>
                                            <span class="select-arrow"></span>
                                            <span asp-validation-for="InformationBase.CategorieId" class="text-danger"></span>
                                            <div class="invalid-feedback">Sélectionner la catégorie du promoteur.</div>
                                        </div>

                                        <div class="col-sm-3 form-group">
                                            <span class="form-label">Type d'activité.</span>
                                            <select id="TypeActiviteId" asp-for="InformationBase.TypeActiviteId" asp-items="@ViewBag.TypeActiviteID as SelectList" class="form-control select2" required>
                                                <option value="">- - - - - -</option>
                                            </select>
                                            <span class="select-arrow"></span>
                                            <span asp-validation-for="InformationBase.TypeActiviteId" class="text-danger"></span>
                                            <div class="invalid-feedback">Sélectionner le type d'activité du projet.</div>
                                        </div>

                                        <div class="col-sm-3 form-group">
                                            <span class="form-label">Forme juridique.</span>
                                            <select id="FormeJuridiqueId" asp-for="InformationBase.FormeJuridiqueId" asp-items="@ViewBag.FormeJuridiqueID as SelectList" class="form-control select2" required>
                                                <option value="">- - - - - -</option>
                                            </select>
                                            <span class="select-arrow"></span>
                                            <span asp-validation-for="InformationBase.FormeJuridiqueId" class="text-danger"></span>
                                            <div class="invalid-feedback">Sélectionner la forme juridique.</div>
                                        </div>

                                        <div class="col-sm-3 form-group">
                                            <span class="form-label">Type financement.</span>
                                            <select id="TypeFinancementId" asp-for="InformationBase.TypeFinancementId" asp-items="@ViewBag.TypeFinancementID as SelectList" class="form-control select2" required>
                                                <option value="">- - - - - -</option>
                                            </select>
                                            <span class="select-arrow"></span>
                                            <span asp-validation-for="InformationBase.TypeFinancementId" class="text-danger"></span>
                                            <div class="invalid-feedback">Sélectionner le type financement.</div>
                                        </div>

                                    </div>

                                    <div class="row">

                                        <div class="col-sm-3 form-group">
                                            <span class="form-label">Regime d'imposition.</span>
                                            <select id="RegimeImpositionId" asp-for="InformationBase.RegimeImpositionId" asp-items="@ViewBag.RegimeImpositionID as SelectList" class="form-control select2" required>
                                                <option value="">- - - - - -</option>
                                            </select>
                                            <span class="select-arrow"></span>
                                            <span asp-validation-for="InformationBase.RegimeImpositionId" class="text-danger"></span>
                                            <div class="invalid-feedback">Sélectionner le regime d'imposition.</div>
                                        </div>

                                        <div class="col-sm-3 form-group">
                                            <span class="form-label">Taux TVA.</span>
                                            <select id="TauxTVAId" asp-for="InformationBase.TauxTVAId" asp-items="@ViewBag.TauxTVAID as SelectList" class="form-control select2" required>
                                                <option value="">- - - - - -</option>
                                            </select>
                                            <span class="select-arrow"></span>
                                            <span asp-validation-for="InformationBase.TauxTVAId" class="text-danger"></span>
                                            <div class="invalid-feedback">Sélectionner le le taux de TVA.</div>
                                        </div>

                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <span class="form-label">PNR supplémentaire</span>
                                                <input asp-for="StructureFinancement.PNRSupplementaire" class="form-control">
                                            </div>
                                        </div>

                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <span class="form-label">Apport supplémentaire</span>
                                                <input asp-for="StructureFinancement.ApportSupplementaire" class="form-control">
                                            </div>
                                        </div>

                                    </div>

                                    <div class="row">

                                        <div class="col-sm-3 form-group">
