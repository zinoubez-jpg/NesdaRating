                                                <option value="">- - - - - -</option>
                                            </select>
                                            <span class="select-arrow"></span>
                                            <span asp-validation-for="InformationBase.CommuneBPId" class="text-danger"></span>
                                            <div class="invalid-feedback">Sélectionner la commune.</div>
                                        </div>

                                        <div class="col-sm-3 form-group">
                                            <span class="form-label">Type de zone</span>
                                            <input id="TypeZoneId" class="form-control" value="- - - - - -" disabled>
                                            <span class="select-arrow"></span>
                                            <span class="text-danger"></span>
                                            <div class="invalid-feedback">Type de zone.</div>
                                        </div>

                                        <div class="col-sm-3 form-group">
                                            <span class="form-label">Zone à promouvoir</span>
                                            <input id="ZonePromouvoir" class="form-control" value="- - - - - -" disabled>
                                            <span class="select-arrow"></span>
                                            <span class="text-danger"></span>
                                            <div class="invalid-feedback">Zone à promouvoir.</div>
                                        </div>

                                        <div class="col-sm-3 form-group">
                                            <div class="form-checkbox">
                                                <label id="ExonerationTVA" asp-for="InformationBase.ExonerationTVA">
