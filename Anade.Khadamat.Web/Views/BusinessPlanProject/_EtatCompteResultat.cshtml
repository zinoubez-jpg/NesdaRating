                                CMT.value = parseFloat(ValeurCoutProjet) * 70 / 100;
                                TauxCMT.value = 70;
                                PNRClassique.value = parseFloat(ValeurCoutProjet) * 18 / 100;
                                TauxPNRClassique.value = 18;

                                ApportPersonnel.value = montant(ApportPersonnel.value);
                                CMT.value = montant(CMT.value);
                                PNRClassique.value = montant(PNRClassique.value);

                                document.getElementById("TauxStructureFinancementID").value = 5;

                                SelectTauxStructureFinancement();
                            }
                            else {

                                ApportPersonnel.value = parseFloat(ValeurCoutProjet) * 15 / 100;
