<script>

    var acc = document.getElementsByClassName("accordionZn");
    var i;

    for (i = 0; i < acc.length; i++) {
        acc[i].addEventListener("click", function () {
            this.classList.toggle("active");
            var panel = this.nextElementSibling;
            if (panel.style.maxHeight) {
                panel.style.maxHeight = null;
            } else {
                panel.style.maxHeight = panel.scrollHeight + "px";
            }
        });
    }

</script>

<script>

    function setActive(buttonContainerId, inputId, value) {
        // Désactiver tous les boutons dans le conteneur spécifié
        var buttons = document.querySelectorAll('#' + buttonContainerId + ' .value-btn');
        buttons.forEach(function (button) {
            button.classList.remove('active');
        });

        // Activer le bouton cliqué
        buttons[value].classList.add('active');

        // Mettre la valeur dans l'input correspondant
        document.getElementById(inputId).value = value;
    }

</script>

<script>

    $(document).ready(function () {
        var i = 1;
        $("#add_row").click(function () {
            b = i - 1;
            $('#addr' + i).html($('#addr' + b).html()).find('td:first-child').html(i + 1);
            $('#tab_logic').append('<tr id="addr' + (i + 1) + '"></tr>');
            i++;
        });
        $("#delete_row").click(function () {
            if (i > 1) {
                $("#addr" + (i - 1)).html('');
                i--;
            }
        });

    });

</script>

<script>

    function SimulerStructure() {

        if (Verif_Champs_Init() == true) {
            return;
        }

        var e = document.getElementById("CategorieId");

        var CategorieValue = e.value;
        var CategorieText = e.options[e.selectedIndex].text;

        e = document.getElementById("TypeActiviteId");
        var TypeActiviteValue = e.value;
        var TypeActiviteText = e.options[e.selectedIndex].text;

        e = document.getElementById("FormeJuridiqueId");
        var FormeJuridiqueValue = e.value;
        var FormeJuridiqueText = e.options[e.selectedIndex].text;

        e = document.getElementById("TypeFinancementId");
        var TypeFinancementValue = e.value;
        var TypeFinancementText = e.options[e.selectedIndex].text;

        e = document.getElementById("RegimeImpositionId");
        var RegimeImpositionValue = e.value;
        var RegimeImpositionText = e.options[e.selectedIndex].text;

        e = document.getElementById("CommuneBPId");
        var CommuneBPValue = e.value;
        var CommuneBPText = e.options[e.selectedIndex].text;

        var x = document.getElementById("ExonerationTVAselect2");

        if (TypeFinancementValue == 1) {

            ApportPersonnel.value = CoutProjet.value;
            TauxApportPersonnel.value = 100;
            CMT.value = 0;
            TauxCMT.value = 0;
            PNRClassique.value = 0;
            TauxPNRClassique.value = 0;

            document.getElementById("TauxStructureFinancementID").value = 1;

            SelectTauxStructureFinancement();
        }
        else {

            ValeurCoutProjet = supp_espace_montant(CoutProjet.value);

            if (TypeFinancementValue == 2) {

                DiffereEmprunt.value = "1 an";

                document.getElementById("DiffereEmpruntID").value = 1;

                ApportPersonnel.value = parseFloat(ValeurCoutProjet) * 50 / 100;
                TauxApportPersonnel.value = 50;
                CMT.value = 0;
                TauxCMT.value = 0;
                PNRClassique.value = parseFloat(ValeurCoutProjet) * 50 / 100;
                TauxPNRClassique.value = 50;

                ApportPersonnel.value = montant(ApportPersonnel.value);
                CMT.value = montant(CMT.value);
                PNRClassique.value = montant(PNRClassique.value);

                document.getElementById("TauxStructureFinancementID").value = 2;

                SelectTauxStructureFinancement();
            }
            else {
                if (TypeFinancementValue == 3) {

                    DiffereEmprunt.value = "1 an et 6 mois";

                    document.getElementById("DiffereEmpruntID").value = 2;

                    if (CategorieValue == 1) {

                        ApportPersonnel.value = parseFloat(ValeurCoutProjet) * 5 / 100;
                        TauxApportPersonnel.value = 5;
                        CMT.value = parseFloat(ValeurCoutProjet) * 70 / 100;
                        TauxCMT.value = 70;
                        PNRClassique.value = parseFloat(ValeurCoutProjet) * 25 / 100;
                        TauxPNRClassique.value = 25;

                        ApportPersonnel.value = montant(ApportPersonnel.value);
                        CMT.value = montant(CMT.value);
                        PNRClassique.value = montant(PNRClassique.value);

                        document.getElementById("TauxStructureFinancementID").value = 3;

                        SelectTauxStructureFinancement();
                    }
                    else {
                        if (TypeZoneId.value == 1) {

                            ApportPersonnel.value = parseFloat(ValeurCoutProjet) * 10 / 100;
                            TauxApportPersonnel.value = 10;
                            CMT.value = parseFloat(ValeurCoutProjet) * 70 / 100;
                            TauxCMT.value = 70;
                            PNRClassique.value = parseFloat(ValeurCoutProjet) * 20 / 100;
                            TauxPNRClassique.value = 20;

                            ApportPersonnel.value = montant(ApportPersonnel.value);
                            CMT.value = montant(CMT.value);
                            PNRClassique.value = montant(PNRClassique.value);

                            document.getElementById("TauxStructureFinancementID").value = 4;

                            SelectTauxStructureFinancement();
                        }
                        else {
                            if (TypeZoneId.value == 2) {

                                ApportPersonnel.value = parseFloat(ValeurCoutProjet) * 12 / 100;
