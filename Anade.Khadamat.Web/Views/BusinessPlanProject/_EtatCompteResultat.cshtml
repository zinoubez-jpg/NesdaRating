            }
            else {

                ExonerationFiscale.value = "03 ans";
                document.getElementById("ExonerationFiscaleID").value = 1;
            }
        }

        if (FormeJuridiqueValue == 1) {
            if (RegimeImpositionId.value == 1) {

                if (TypeActiviteValue == 1) {

                    TauxIFU.value = "0 %";
                    TauxIBS.value = "19 %";
                }
                else {
                    if (TypeActiviteValue == 2) {

                        TauxIFU.value = "0 %";
                        TauxIBS.value = "23 %";
                    }
                    else {

                        TauxIFU.value = "0 %";
                        TauxIBS.value = "26 %";
                    }
                }
            }
            else {
                if (TypeActiviteValue == 1) {

                    TauxIBS.value = "0 %";
                    TauxIFU.value = "05 %";
                }
                else {
                    if (TypeActiviteValue == 3) {

                        TauxIBS.value = "0 %";
                        TauxIFU.value = "12 %";
                    }
                }
            }
        }
        else {
            TauxIFU.value = "0 %";
            TauxIBS.value = "0 %";
        }

        GetValueStringModel();
    }

    $(document).ready(function () {
        $('#CommuneBPId').on('change', function () {
            const selectedId = $(this).val();
            const _url = "/BusinessPlanProject/GetCommune/" + selectedId;
            //console.log("Id : " + selectedId);
            if (selectedId) {
                $.ajax({
                    type: "POST",
                    url: _url,
                    dataType: "json",
                    success: function (result) {
                        if (document.getElementById("TypeZoneId")) {
                            document.getElementById("TypeZoneId").value = result.typeZone.designationFr;
                        }
                        if (document.getElementById("ZonePromouvoir")) {
                            if (result.zonePromouvoir == true) {
                                document.getElementById("ZonePromouvoir").value = "Oui";
                            }
                            else {
                                document.getElementById("ZonePromouvoir").value = "Non";
                            }
                        }
                        if (document.getElementById("GrandSud")) {
                            if (result.wilayaBP.grandSud == true) {
                                document.getElementById("GrandSud").value = "Oui";
                            }
                            else {
                                document.getElementById("GrandSud").value = "Non";
                            }
                        }
                    },
                    error: function () {
                        /*alert("Erreur : Choisir une commune");*/
                        TypeZoneId.value = "- - - - - -";
                        ZonePromouvoir.value = "- - - - - -";
                    }
                });
            }
            else {
                TypeZoneId.value = "- - - - - -";
                ZonePromouvoir.value = "- - - - - -";
            }
        });
    });

</script>

<script>

    function checkedExonerationTVA() {

        InitChamps();

        var e = document.getElementById("ExonerationTVAselect2");

        var ExonerationTVAValue = e.value;
        var ExonerationTVAText = e.options[e.selectedIndex].text;

        if (ExonerationTVAValue == "true") {
            document.getElementById("ExonerationTVA").checked = true;
        }
        else {
            if (ExonerationTVAValue == "false") {
                document.getElementById("ExonerationTVA").checked = false;
            }
            else {
                document.getElementById("ExonerationTVA").checked = null;
            }
        }

    }

    function SelectTauxStructureFinancement() {

        var e = document.getElementById("TauxStructureFinancementID");

        var TauxStructureFinancementIdValue = e.value;
        var TauxStructureFinancementIdText = e.options[e.selectedIndex].text;

        const TauxApportPersonnelValue = TauxStructureFinancementIdText.substr(1, 3);
        const TauxCMTValue = TauxStructureFinancementIdText.substr(5, 3);
        const TauxPNRClassiqueValue = TauxStructureFinancementIdText.substr(9, 3);

        TauxApportPersonnel.value = parseInt(TauxApportPersonnelValue);
        TauxCMT.value = parseInt(TauxCMTValue);
        TauxPNRClassique.value = parseInt(TauxPNRClassiqueValue);
    }

    function montant(val_montant) {
        x = val_montant.split('.');
        x1 = x[0];
        x2 = x.length > 1 ? '.' + x[1] : '';
        var rgx = /(\d+)(\d{3})/;
        while (rgx.test(x1)) {
            x1 = x1.replace(rgx, '$1' + ' ' + '$2');
        }

        return x1 + x2;
    }

    function verif_nombre(champ) {
        var chiffres = new RegExp("[0-9]");
        var verif;
        var points = 0;

        for (x = 0; x < champ.value.length; x++) {
            verif = chiffres.test(champ.value.charAt(x));
            if (champ.value.charAt(x) == "." && x != 0) { verif = true; points++; }
            if (points > 1) { verif = false; points = 1; }
            if (verif == false) { champ.value = champ.value.substr(0, x) + champ.value.substr(x + 1, champ.value.length - x + 1); x--; }
        }
    }

    function supp_espace_montant(val_montant) {

        val_montant_sans_espace = val_montant.replaceAll(" ", "");

        return val_montant_sans_espace;
    }

