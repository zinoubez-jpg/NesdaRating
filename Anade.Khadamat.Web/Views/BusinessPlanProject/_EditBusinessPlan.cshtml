@model Anade.Khadamat.Domain.BusinessPlan



<div class="modal-header">
    <h5 class="modal-title" id="modalLabel">Ajouter une Apréciation</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <div id="modalMessages"></div>
    <div id="booking" class="section">
        <div class="section-center">
            <div class="container" style="max-height: auto">
                <div class="row">
                    <div class="col-md-12">
                        <div class="booking-form">
                            <form asp-action="EditBusinessPlan" asp-controller="BusinessPlanProject"
                                  data-ajax="true"
                                  data-ajax-success="AddBusinessPlan">
                                <input asp-for="Id" type="hidden" />
                                <input asp-for="NumeroSIEJE" type="hidden" />
                                <input asp-for="Code" type="hidden" />
                                <input asp-for="Date_Generation" type="hidden" />

                                @*<div class="row">
                                   
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <span class="form-label">Score Total</span>
                                            <input asp-for="ScoreTotal" class="form-control" readonly>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <span class="form-label">Délibération</span>
                                            <input asp-for="Deliberation" class="form-control" readonly>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-12">
                                    <div class="form-group">
                                        <span class="form-label">Appreciation</span>
                                        <textarea asp-for="appreciation" class="form-control" placeholder="Appreciation" required> </textarea>
                                        <span asp-validation-for="appreciation" class="text-danger"></span>
                                    </div>
                                </div>*@

                                <div class="form-group modal-footer">
                                    <input type="submit" class="btn btn-outline-primary" value="Soumettre" />
                                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>


