            || RegimeImpositionValue == ""
            || CommuneBPValue == ""
            || ExonerationTVAValue == "") {

            return true;
        }
        else {

            return false;
        }
    }

    function GetValueStringModel() {

        CoutProjetModel.value = parseFloat(supp_espace_montant(CoutProjet.value));
        ApportPersonnelModel.value = parseFloat(supp_espace_montant(ApportPersonnel.value));
        CMTModel.value = parseFloat(supp_espace_montant(CMT.value));
        PNRClassiqueModel.value = parseFloat(supp_espace_montant(PNRClassique.value));
        PNRSupplementaireModel.value = parseFloat(supp_espace_montant(PNRSupplementaire.value));
        ApportSupplementaireModel.value = parseFloat(supp_espace_montant(ApportSupplementaire.value));
    }

