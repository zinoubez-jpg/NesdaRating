@model IEnumerable<Anade.Khadamat.Domain.BusinessPlan>
<partial name="_Message" />

<table class="table display compact">

    <thead>

        <tr>
            <th>
                N° Business plan
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Date_Creation)
            </th>
            <th>
                Complet (Oui/Non)?
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Utilisateur)
            </th>

            <th></th>
        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Code)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Date_Creation)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Complet)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Utilisateur)
                </td>
                <td>

                    @if (item.Complet)
                    {
                        <a asp-controller="Reporting" asp-action="PrintBusinessPlan" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">  <i class='fa fa-print' style='color:#7ea591'></i> Imprimer</a>
                    }
                    else
                    {
                        <button data-bs-target="#modalBP" data-bs-toggle="modal" class="btn btn-secondary btn-sm"
                                @*data-url="@Url.Action("EditBusinessPlan",new { id=item.Id})">*@
                                data-url="@Url.Action("EditBusinessPlan", "BusinessPlanProject", new { id = item.Id })">
                            Modifier le buisiness plan
                        </button>
                        if (item.EtapeId == 1)
                        {
                            <button data-bs-target="#modalBP" data-bs-toggle="modal" class="btn btn-dark btn-sm clignote"
                                    data-url="@Url.Action("AddInvestissement2", "BusinessPlanProject", new { id = item.Id })">
                                Etape 02 Investissement
                            </button>
                        }
                        else
                        {
                            if (item.EtapeId == 2)
                            {
                                <button data-bs-target="#modalBP" data-bs-toggle="modal" class="btn btn-dark btn-sm clignote"
                                        @*data-url="@Url.Action("EditBusinessPlan",new { id=item.Id})">*@
                                        data-url="@Url.Action("AddChiffreAcffaires", "BusinessPlanProject", new { id = item.Id })">
                                    Etape 03 Chiffre d'affaires
                                </button>
                            }
                            else
                            {
                                if (item.EtapeId == 3)
                                {
                                    <button data-bs-target="#modalBP" data-bs-toggle="modal" class="btn btn-dark btn-sm clignote"
                                            @*data-url="@Url.Action("EditBusinessPlan",new { id=item.Id})">*@
                                            data-url="@Url.Action("AddAchatsDirects", "BusinessPlanProject", new { id = item.Id })">
                                        Etape 04 Achats directs
                                    </button>
                                }
                                else
                                {
                                    if (item.EtapeId == 4)
                                    {
                                        <button data-bs-target="#modalBP_Full" data-bs-toggle="modal" class="btn btn-dark btn-sm clignote"
                                                @*data-url="@Url.Action("EditBusinessPlan",new { id=item.Id})">*@
                                                data-url="@Url.Action("AddMasseSalariale", "BusinessPlanProject", new { id = item.Id })">
                                            Etape 05 Masse salariale
                                        </button>
                                    }
                                    else
                                    {
                                        if (item.EtapeId == 5)
                                        {
                                            <button data-bs-target="#modalBP" data-bs-toggle="modal" class="btn btn-dark btn-sm clignote"
                                                    @*data-url="@Url.Action("EditBusinessPlan",new { id=item.Id})">*@
                                                    data-url="@Url.Action("AddChargesExternes", "BusinessPlanProject", new { id = item.Id })">
                                                Etape 06 Charges externes
                                            </button>
                                        }
                                        else
                                        {
                                            if (item.EtapeId == 6)
                                            {
                                                <a href="@Url.Action("EtatsSyntheseBusinessPlan", "BusinessPlanProject", new { id = item.Id })"
                                                   class="btn btn-dark btn-sm clignote"
                                                   role="button">
                                                    Etape 07 Calcule (Etats de synthèse)
                                                </a>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-dark btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                                                    Etape 07 Etats de synthèse
                                                </button>
                                                <ul class="dropdown-menu">
                                                    @*<li style="text-align: center;">
                                                        <a class="dropdown-item" href="@Url.Action("EtatsSyntheseBusinessPlan", "BusinessPlanProject", new { id = item.Id })">
                                                            Recalcule (Etats de synthèse)
                                                        </a>
                                                    </li>*@
                                                    <li style="text-align: center;">
                                                        <a class="dropdown-item" data-bs-target="#modalBP" data-bs-toggle="modal" data-url="@Url.Action("EtatStructureInvestissement", "BusinessPlanProject", new { id = item.Id })">Structure d'investissement</a>
                                                    </li>
                                                    <li style="text-align: center;">
                                                        <a class="dropdown-item" data-bs-target="#modalBP_Full" data-bs-toggle="modal" data-url="@Url.Action("EtatCompteResultat", "BusinessPlanProject", new { id = item.Id })">Compte de résultat</a>
                                                    </li>
                                                    <li style="text-align: center;">
                                                        <a class="dropdown-item" data-bs-target="#modalBP_Full" data-bs-toggle="modal" data-url="@Url.Action("EtatTFT", "BusinessPlanProject", new { id = item.Id })">T.F.T</a>
                                                    </li>
                                                    <li style="text-align: center;">
                                                        <a class="dropdown-item" data-bs-target="#modalBP_Full" data-bs-toggle="modal" data-url="@Url.Action("EtatPlanTresorerie", "BusinessPlanProject", new { id = item.Id })">Plan de trésorerie</a>
                                                    </li>
                                                    <li style="text-align: center;">
                                                        <a class="dropdown-item" data-bs-target="#modalBP_Full" data-bs-toggle="modal" data-url="@Url.Action("EtatEvaluationProjet", "BusinessPlanProject", new { id = item.Id })">Evaluation du projet</a>
                                                    </li>
                                                </ul>

                                            }

                                        }
                                    }
                                }
                            }
                        }

                    }

                </td>
            </tr>
        }

    </tbody>

</table>

<script>
    window.setTimeout(function () {
        $(".alert").fadeTo(500, 0).slideUp(500, function () {
            $(this).remove();
        });
    }, 2000);
</script>

