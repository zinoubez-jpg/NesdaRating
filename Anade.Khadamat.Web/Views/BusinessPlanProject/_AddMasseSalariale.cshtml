<script>

    var acc = document.getElementsByClassName("accordionZn");
    var i;

    for (i = 0; i < acc.length; i++) {
        acc[i].addEventListener("click", function () {
            this.classList.toggle("active");
            var panel = this.nextElementSibling;
            if (panel.style.maxHeight) {
                panel.style.maxHeight = null;
            } else {
                panel.style.maxHeight = panel.scrollHeight + "px";
            }
        });
    }

</script>

<script>

    function setActive(buttonContainerId, inputId, value) {
        // Désactiver tous les boutons dans le conteneur spécifié
        var buttons = document.querySelectorAll('#' + buttonContainerId + ' .value-btn');
        buttons.forEach(function (button) {
            button.classList.remove('active');
        });

        // Activer le bouton cliqué
        buttons[value].classList.add('active');

        // Mettre la valeur dans l'input correspondant
        document.getElementById(inputId).value = value;
    }

</script>

<script>

    $(document).ready(function () {
        var i = 1;
        $("#add_row").click(function () {
            b = i - 1;
            $('#addr' + i).html($('#addr' + b).html()).find('td:first-child').html(i + 1);
            $('#tab_logic').append('<tr id="addr' + (i + 1) + '"></tr>');
            i++;
        });
        $("#delete_row").click(function () {
            if (i > 1) {
                $("#addr" + (i - 1)).html('');
                i--;
            }
        });

    });

</script>

<script>

    function CalculerPaie() {

        if (Verif_Champs_Init() == true) {
            return;
        }

        ValeurSalaireBase = supp_espace_montant(SalaireBaseId.value);

        ValeurIndemnitesPrimesCotisables = supp_espace_montant(IndemnitesPrimesCotisablesId.value);
        ValeurIndemnitesPrimesImposables = supp_espace_montant(IndemnitesPrimesImposablesId.value);
        ValeurSLR_Indemnites_PrimesNonImplCotl = supp_espace_montant(SLR_Indemnites_PrimesNonImplCotlId.value);

        ValeurNbEmploi01Id = supp_espace_montant(NbEmploi01Id.value);
        ValeurNbEmploi02Id = supp_espace_montant(NbEmploi02Id.value);
        ValeurNbEmploi03Id = supp_espace_montant(NbEmploi03Id.value);
        ValeurNbEmploi04Id = supp_espace_montant(NbEmploi04Id.value);
        ValeurNbEmploi05Id = supp_espace_montant(NbEmploi05Id.value);
        ValeurNbEmploi06Id = supp_espace_montant(NbEmploi06Id.value);
        ValeurNbEmploi07Id = supp_espace_montant(NbEmploi07Id.value);

        document.getElementById('GainSalaireBaseId').innerHTML = SalaireBaseId.value;
        document.getElementById('GainIndemnitesPrimesCotisablesId').innerHTML = IndemnitesPrimesCotisablesId.value;
        document.getElementById('GainIndemnitesPrimesImposablesId').innerHTML = IndemnitesPrimesImposablesId.value;
        document.getElementById('GainIndemnitesPrimesNonImposablesCotisablesId').innerHTML = SLR_Indemnites_PrimesNonImplCotlId.value;

        SalairePoste = parseFloat(ValeurSalaireBase) + parseFloat(ValeurIndemnitesPrimesCotisables);

        ValeurRetenuSecuriteSociale = parseFloat(SalairePoste * 9 / 100);

        document.getElementById('RetenueSecuriteSocialeId').innerHTML = montant(ValeurRetenuSecuriteSociale.toString());

        ValeurChargesPatronales = parseFloat(SalairePoste * 26 / 100);

        document.getElementById('SumChargesPatronalesId').innerHTML = montant(ValeurChargesPatronales.toString());

        SalaireImposable = parseFloat(SalairePoste) - parseFloat(ValeurRetenuSecuriteSociale) + parseFloat(ValeurIndemnitesPrimesImposables);

        document.getElementById('SumSImposableId').innerHTML = montant(SalaireImposable.toString());

        ValeurGainTotaux = parseFloat(SalairePoste) + parseFloat(ValeurIndemnitesPrimesImposables) + parseFloat(ValeurSLR_Indemnites_PrimesNonImplCotl);

        document.getElementById('SumSImposableId').innerHTML = montant(SalaireImposable.toString());

        ValeurIRG = 10;

        if (SalaireImposable > 320000) {
                ValeurIRG = ((SalaireImposable - 320000) * 35 / 100) + 52800 + 24000 + 10800 + 4600 - 1500;
        }

        else {
            if (SalaireImposable <= 320000 && SalaireImposable > 160001) {
                    ValeurIRG = ((SalaireImposable - 160000) * 33 / 100) + 24000 + 10800 + 4600 - 1500;
            }
            else {
                if (SalaireImposable <= 160001 && SalaireImposable > 80001) {
                        ValeurIRG = ((SalaireImposable - 80000) * 30 / 100) + 10800 + 4600 - 1500;
                }
                else {
                    if (SalaireImposable <= 80001 && SalaireImposable > 40001) {
                            ValeurIRG = ((SalaireImposable - 40000) * 27 / 100) + 4600 - 1500;
                    }
                    else {
                        if (SalaireImposable <= 40001 && SalaireImposable > 35001) {

                            Valeur_01 = ((SalaireImposable - 20000) * 23 / 100);
                            Valeur_02 = ((SalaireImposable - 20000) * 92 / 1000);

                            if (Valeur_02 < 1000) {
                                ValeurIRG = Valeur_01 - 1000;
                            }
                            else {
                                if (Valeur_02 > 1500) {
                                    ValeurIRG = Valeur_01 - 1500;
                                }
                                else {
                                    ValeurIRG = Valeur_01 - Valeur_02;
                                }
                            }

                        }
                        else {
                            if (SalaireImposable <= 35001 && SalaireImposable > 30000) {

                                Valeur_01 = ((SalaireImposable - 20000) * 23 / 100);
                                Valeur_02 = ((SalaireImposable - 20000) * 92 / 1000);
                                Valeur_03 = 0;

                                if (Valeur_02 < 1000) {
                                    Valeur_03 = Valeur_01 - 1000;
                                }
                                else {
                                    if (Valeur_02 > 1500) {
                                        Valeur_03 = Valeur_01 - 1500;
                                    }
                                    else {
                                        Valeur_03 = Valeur_01 - Valeur_02;
                                    }
                                }

                                ValeurIRG = Valeur_03 * (137 / 51) - (27925 / 8);
                            }
                            else { // Cas SalaireImposable <= 30000
                                    ValeurIRG = 0;
                                }
                            }
                        }
                    }
                }
            }

        document.getElementById('RetenueIGRId').innerHTML = montant(ValeurIRG.toString());

        ValeurGainTotaux = parseFloat(ValeurSalaireBase) + parseFloat(ValeurIndemnitesPrimesCotisables) + parseFloat(ValeurIndemnitesPrimesImposables) + parseFloat(ValeurSLR_Indemnites_PrimesNonImplCotl);

        document.getElementById('GainTotauxId').innerHTML = montant(ValeurGainTotaux.toString());

        ValeurRetenueTotaux = ValeurRetenuSecuriteSociale + parseFloat(ValeurIRG);

        document.getElementById('RetenueTotauxId').innerHTML = montant(ValeurRetenueTotaux.toString());

        ValeurNetPayer = ValeurGainTotaux - ValeurRetenueTotaux;

