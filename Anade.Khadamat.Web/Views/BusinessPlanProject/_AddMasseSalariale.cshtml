            }
        }

    }

    function SelectTauxStructureFinancement() {

        var e = document.getElementById("TauxStructureFinancementID");

        var TauxStructureFinancementIdValue = e.value;
        var TauxStructureFinancementIdText = e.options[e.selectedIndex].text;

        const TauxApportPersonnelValue = TauxStructureFinancementIdText.substr(1, 3);
        const TauxCMTValue = TauxStructureFinancementIdText.substr(5, 3);
        const TauxPNRClassiqueValue = TauxStructureFinancementIdText.substr(9, 3);

        TauxApportPersonnel.value = parseInt(TauxApportPersonnelValue);
        TauxCMT.value = parseInt(TauxCMTValue);
        TauxPNRClassique.value = parseInt(TauxPNRClassiqueValue);
    }

    function montant(val_montant) {
        x = val_montant.split('.');
        x1 = x[0];
        x2 = x.length > 1 ? '.' + x[1] : '';
        var rgx = /(\d+)(\d{3})/;
        while (rgx.test(x1)) {
            x1 = x1.replace(rgx, '$1' + ' ' + '$2');
        }

        return x1 + x2;
    }

    function verif_nombre(champ) {
        var chiffres = new RegExp("[0-9]");
        var verif;
        var points = 0;

        for (x = 0; x < champ.value.length; x++) {
            verif = chiffres.test(champ.value.charAt(x));
            if (champ.value.charAt(x) == "." && x != 0) { verif = true; points++; }
            if (points > 1) { verif = false; points = 1; }
            if (verif == false) { champ.value = champ.value.substr(0, x) + champ.value.substr(x + 1, champ.value.length - x + 1); x--; }
        }
    }

    function supp_espace_montant(val_montant) {

        val_montant_sans_espace = val_montant.replaceAll(" ", "");

        return val_montant_sans_espace;
    }

    function InitChamps() {

        document.getElementById("TypeMaterielId").value = 0;

        DesignationMateriel.value = "";
        DureeAmortissement.value = "";
        MontantAcqui01.value = "";
        MontantAcqui02.value = "";
        MontantAcqui03.value = "";
        MontantAcqui04.value = "";
        MontantAcqui05.value = "";
        MontantAcqui06.value = "";
        MontantAcqui07.value = "";

    }

    function GetValueStringModel() {

        CoutProjetModel.value = parseFloat(supp_espace_montant(CoutProjet.value));
        ApportPersonnelModel.value = parseFloat(supp_espace_montant(ApportPersonnel.value));
        CMTModel.value = parseFloat(supp_espace_montant(CMT.value));
        PNRClassiqueModel.value = parseFloat(supp_espace_montant(PNRClassique.value));
        PNRSupplementaireModel.value = parseFloat(supp_espace_montant(PNRSupplementaire.value));
        ApportSupplementaireModel.value = parseFloat(supp_espace_montant(ApportSupplementaire.value));
    }

    function formatMoney(amount, decimalCount = 2, decimal = ",", thousands = ".") {
        try {
            decimalCount = Math.abs(decimalCount);
            decimalCount = isNaN(decimalCount) ? 2 : decimalCount;

            const negativeSign = amount < 0 ? "-" : "";

            let i = parseInt(amount = Math.abs(Number(amount) || 0).toFixed(decimalCount)).toString();
            let j = (i.length > 3) ? i.length % 3 : 0;

            return negativeSign +
                (j ? i.substr(0, j) + thousands : '') +
                i.substr(j).replace(/(\d{3})(?=\d)/g, "$1" + thousands) +
                (decimalCount ? decimal + Math.abs(amount - i).toFixed(decimalCount).slice(2) : "");
        } catch (e) {
            console.log(e)
        }
    };

    //document.getElementById("b").addEventListener("click", event => {
    //    document.getElementById("x").innerText = "Result was: " + formatMoney(document.getElementById("d").value);
    //});

</script>

