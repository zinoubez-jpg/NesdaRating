@section scripts{

    <partial name="_ValidationScriptsPartial" />

    <partial name="_select2.script" />
    <partial name="_jqueryui.script" />
    <script src="~/js/FournisseurSelect2.js"></script>
    <script src="~/js/PromoteurSelect2.js"></script>

    <script>
         $(function () {
             $("#Id").select2({

                    templateResult: promoteurSelect2ResultTemplate,
                    templateSelection:promoteurSelect2SelectionTemplate,
                    escapeMarkup: escapeMarkup,
                     ajax: {
                            url:"@(ApiServicesUrls.GetBaseUrl<Anade.Khadamat.Domain.PROMOTEUR>("suivipagedfiltered")+"?Codeannexe="+ structure.CodeStructure)",
                            dataType: 'json',
                            processResults: processResult
                        },
             });
         });

    </script>
}

